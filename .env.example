# ─────────────────────────────────────────────
# Upstox API credentials
# Get these from https://developer.upstox.com/
# ─────────────────────────────────────────────

# Your Upstox API Key (client_id)
UPSTOX_API_KEY=your_api_key_here

# Your Upstox API Secret (client_secret)
UPSTOX_API_SECRET=your_api_secret_here
# Access token (generated after OAuth login — see README for how to get this)
UPSTOX_ACCESS_TOKEN=


# ─────────────────────────────────────────────
# Optional settings
# ─────────────────────────────────────────────

# Default output directory for CSVs / Parquet files
OUTPUT_DIR=./data

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
